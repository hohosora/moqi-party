rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function roomPath(code) {
      return /databases/$(database)/documents/rooms/$(code);
    }
    function roomIsVoting(code) {
      return get(roomPath(code)).data.phase == 'voting';
    }
    function playerExists(code, uid) {
      return exists(/databases/$(database)/documents/rooms/$(code)/players/$(uid));
    }

    // V3 admission: keep legacy rooms readable during migration.
    function isV3(data) { return 'protocol' in data && data.protocol == 3; }
    function gatePath(code) { return /databases/$(database)/documents/roomInvites/$(code); }
    function playerPath(code,uid) { return /databases/$(database)/documents/rooms/$(code)/players/$(uid); }
    function isMember(code) { return playerExists(code,request.auth.uid); }
    function validSeat(seat) { return seat is string && seat.matches('^([1-9]|1[0-9]|20)$'); }
    // Admin-only rollout control. Missing, false or invalid values fail closed.
    // Client rules intentionally grant no access to rolloutControls.
    function v3CreationEnabled() {
      let control = /databases/$(database)/documents/rolloutControls/p3Admission;
      return exists(control) && get(control).data.createEnabled == true;
    }
    function validGate(g) {
      return g.keys().hasOnly(['phase','count','seats'])
        && g.keys().hasAll(['phase','count','seats'])
        && g.phase in ['lobby','voting']
        && g.count is int && g.count >= 1 && g.count <= 20
        && g.seats is map && g.seats.size() == g.count;
    }
    function initialGate(g) {
      return validGate(g) && g.phase == 'lobby' && g.count == 1 && g.seats == {'1':true};
    }
    function validJoin(before,after,seat) {
      return validSeat(seat) && validGate(after)
        && before.phase == 'lobby' && after.phase == 'lobby'
        && after.count == before.count + 1
        && !(seat in before.seats) && after.seats[seat] == true
        && after.seats.diff(before.seats).affectedKeys().hasOnly([seat])
        && after.diff(before).affectedKeys().hasOnly(['count','seats']);
    }
    function validV3Create(code,data) {
      return isV3(data) && !exists(gatePath(code))
        && !exists(playerPath(code,request.auth.uid))
        && initialGate(getAfter(gatePath(code)).data)
        && getAfter(playerPath(code,request.auth.uid)).data.seat == '1';
    }
    function validV3Start(code,data) {
      let before = get(gatePath(code)).data;
      let after = getAfter(gatePath(code)).data;
      return before.phase == 'lobby' && before.count >= 2
        && after.phase == 'voting' && after.diff(before).affectedKeys().hasOnly(['phase'])
        && data.scores.size() == before.count;
    }
    function readableRoomChildren(code) {
      return !isV3(get(roomPath(code)).data) || isMember(code);
    }
    // Never trust browser-side form limits. Keep all values bounded at the database.
    function validHeroImage(data) {
      return !('heroImage' in data) || (
        data.heroImage is string
        && data.heroImage.size() <= 40000
        && (data.heroImage == '' || data.heroImage.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
      );
    }
    function validAppearance(data) {
      return (!('theme' in data) || data.theme in ['party', 'panel', 'minimal'])
        && (!('minimalHue' in data) ||
          (data.minimalHue is int && data.minimalHue >= 0 && data.minimalHue <= 359))
        && validHeroImage(data);
    }
    function validQuestion(question) {
      // Compact structure-only check for each entry. Firestore has a hard
      // 1,000-expression limit; deeper text checks are sampled below and
      // full per-option input validation remains in the client.
      return question is map
        && question.q is string
        && question.a is list && question.a.size() == 4
        && question.talk is string;
    }
    function validQuestionAt(questions, index) {
      return index >= questions.size() || validQuestion(questions[index]);
    }
    function validQuestions(questions, count) {
      return questions is list
        && questions.size() == count
        && validQuestionAt(questions, 0) && validQuestionAt(questions, 1)
        && validQuestionAt(questions, 2) && validQuestionAt(questions, 3)
        && validQuestionAt(questions, 4) && validQuestionAt(questions, 5)
        && validQuestionAt(questions, 6) && validQuestionAt(questions, 7)
        && validQuestionAt(questions, 8) && validQuestionAt(questions, 9)
        && validQuestionAt(questions, 10) && validQuestionAt(questions, 11)
        && questions[0].q.size() > 0 && questions[0].q.size() <= 120
        && questions[0].talk.size() > 0 && questions[0].talk.size() <= 160;
    }
    // The atomic V3 create requires BOTH room and invite writes. Split the same
    // question checks across their rules to stay within the expression budget.
    // Legacy rooms retain the original full validator.
    function validV3QuestionsFirst(questions,count) {
      return questions is list && questions.size() == count
        && validQuestionAt(questions,0) && validQuestionAt(questions,1)
        && validQuestionAt(questions,2) && validQuestionAt(questions,3)
        && validQuestionAt(questions,4) && validQuestionAt(questions,5)
        && questions[0].q.size() > 0 && questions[0].q.size() <= 120
        && questions[0].talk.size() > 0 && questions[0].talk.size() <= 160;
    }
    function validV3QuestionsRest(questions) {
      return questions is list
        && validQuestionAt(questions,6) && validQuestionAt(questions,7)
        && validQuestionAt(questions,8) && validQuestionAt(questions,9)
        && validQuestionAt(questions,10) && validQuestionAt(questions,11);
    }
    function validQuickSettings(data) {
      return (!('quickMode' in data) || data.quickMode is bool)
        && (!('quickScene' in data) || data.quickScene == null ||
          data.quickScene in ['general', 'friends', 'church', 'company', 'school', 'family', 'community']);
    }
    function validRoomCreate(data, code) {
      return code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && data.keys().hasOnly([
          'hostUid', 'phase', 'roundIndex', 'totalRounds', 'seconds', 'questions',
          'scores', 'streaks', 'usedDoubles', 'lastResult', 'deadline', 'createdAt',
          'heroImage', 'theme', 'minimalHue', 'quickMode', 'quickScene', 'protocol'
        ])
        && data.keys().hasAll([
          'hostUid', 'phase', 'roundIndex', 'totalRounds', 'seconds', 'questions',
          'scores', 'streaks', 'usedDoubles', 'lastResult', 'deadline', 'createdAt'
        ])
        && data.hostUid == request.auth.uid
        && data.phase == 'lobby'
        && data.roundIndex == -1
        && data.totalRounds in [6, 8, 10, 12]
        && data.seconds in [15, 30, 45]
        && data.createdAt is int && data.createdAt > 0
        && (isV3(data) ? validV3QuestionsFirst(data.questions,data.totalRounds)
          : validQuestions(data.questions,data.totalRounds))
        && data.scores is map && data.scores.size() == 0
        && data.streaks is map && data.streaks.size() == 0
        && data.usedDoubles is map && data.usedDoubles.size() == 0
        && data.lastResult == null && data.deadline == null
        && validAppearance(data) && validQuickSettings(data);
    }
    function validDeadline(data) {
      return data.deadline is int && data.deadline > 0;
    }
    function validRoundResult(data) {
      return data.scores is map && data.scores.size() <= 20
        && data.streaks is map && data.streaks.size() <= 20
        && data.usedDoubles is map && data.usedDoubles.size() <= 20
        && data.lastResult is map
        && data.lastResult.keys().hasAll(['counts', 'top', 'cold', 'totalVotes', 'gains'])
        && data.lastResult.keys().hasOnly(['counts', 'top', 'cold', 'totalVotes', 'gains'])
        && data.lastResult.counts is list && data.lastResult.counts.size() == 4
        && data.lastResult.top is list && data.lastResult.top.size() <= 4
        && data.lastResult.cold is list && data.lastResult.cold.size() <= 4
        && data.lastResult.totalVotes is int
        && data.lastResult.totalVotes >= 0 && data.lastResult.totalVotes <= 20
        && data.lastResult.gains is map && data.lastResult.gains.size() <= 20;
    }
    function onlyUpdated(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function validRoomUpdate(code) {
      return resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && validAppearance(request.resource.data)
        && (
          // Host can change the look without changing gameplay or scores.
          (request.resource.data.phase == resource.data.phase
            && onlyUpdated(['heroImage', 'theme', 'minimalHue']))
          // One-time lobby -> first round.
          || (resource.data.phase == 'lobby' && request.resource.data.phase == 'voting'
            && request.resource.data.roundIndex == 0
            && validDeadline(request.resource.data)
            && request.resource.data.scores is map
            && request.resource.data.scores.size() <= 20
            && (!isV3(resource.data) || validV3Start(code,request.resource.data))
            && request.resource.data.streaks is map
            && request.resource.data.usedDoubles is map
            && request.resource.data.lastResult == null
            && onlyUpdated(['phase', 'roundIndex', 'deadline', 'scores', 'streaks', 'usedDoubles', 'lastResult']))
          // Host's scoreboard is settled only at reveal.
          || (resource.data.phase == 'voting' && request.resource.data.phase == 'reveal'
            && request.resource.data.roundIndex == resource.data.roundIndex
            && validRoundResult(request.resource.data)
            && onlyUpdated(['phase', 'scores', 'streaks', 'usedDoubles', 'lastResult']))
          // Advance to the next question without modifying previous scores.
          || (resource.data.phase == 'reveal' && request.resource.data.phase == 'voting'
            && request.resource.data.roundIndex == resource.data.roundIndex + 1
            && request.resource.data.roundIndex < resource.data.totalRounds
            && validDeadline(request.resource.data)
            && request.resource.data.lastResult == null
            && onlyUpdated(['phase', 'roundIndex', 'deadline', 'lastResult']))
          // Finish only after the configured final question.
          || (resource.data.phase == 'reveal' && request.resource.data.phase == 'finished'
            && request.resource.data.roundIndex + 1 == resource.data.totalRounds
            && request.resource.data.deadline == null
            && onlyUpdated(['phase', 'deadline']))
        );
    }

    match /roomInvites/{code} {
      // Only non-identifying occupancy is exposed on exact code lookup.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && v3CreationEnabled()
        && initialGate(request.resource.data)
        && !exists(roomPath(code)) && !exists(playerPath(code,request.auth.uid))
        && isV3(getAfter(roomPath(code)).data)
        && getAfter(roomPath(code)).data.hostUid == request.auth.uid
        && validV3QuestionsRest(getAfter(roomPath(code)).data.questions)
        && getAfter(playerPath(code,request.auth.uid)).data.seat == '1';
      allow update: if signedIn() && isV3(get(roomPath(code)).data) && (
        (!isMember(code) && get(roomPath(code)).data.phase == 'lobby'
          && getAfter(roomPath(code)).data.phase == 'lobby'
          && validJoin(resource.data,request.resource.data,
            getAfter(playerPath(code,request.auth.uid)).data.seat))
        || (isMember(code) && get(roomPath(code)).data.hostUid == request.auth.uid
          && get(roomPath(code)).data.phase == 'lobby'
          && getAfter(roomPath(code)).data.phase == 'voting'
          && resource.data.phase == 'lobby' && resource.data.count >= 2
          && request.resource.data.phase == 'voting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase']))
      );
      allow delete: if false;
    }
    match /rooms/{code} {
      // Legacy rooms retain exact-code lookup. V3 full room is member-only.
      allow get: if signedIn() && (resource == null || !isV3(resource.data) || isMember(code));
      allow list: if false;
      allow create: if signedIn() && validRoomCreate(request.resource.data, code)
        && ((!('protocol' in request.resource.data) && !exists(gatePath(code)))
          || validV3Create(code,request.resource.data));
      allow update: if signedIn() && validRoomUpdate(code);
      allow delete: if false;

      match /players/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || readableRoomChildren(code));
        allow list: if signedIn() && readableRoomChildren(code);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'emoji', 'joinedAt', 'seat'])
          && request.resource.data.keys().hasAll(['uid', 'name', 'emoji', 'joinedAt'])
          && request.resource.data.uid == uid
          && (
            (exists(roomPath(code)) && !isV3(get(roomPath(code)).data)
              && !('seat' in request.resource.data) && get(roomPath(code)).data.phase == 'lobby')
            || (validSeat(request.resource.data.seat)
              && isV3(getAfter(roomPath(code)).data)
              && getAfter(roomPath(code)).data.phase == 'lobby'
              && ((!exists(roomPath(code)) && !exists(gatePath(code))
                    && getAfter(roomPath(code)).data.hostUid == uid
                    && request.resource.data.seat == '1'
                    && initialGate(getAfter(gatePath(code)).data))
                || (exists(roomPath(code)) && isV3(get(roomPath(code)).data)
                    && get(roomPath(code)).data.phase == 'lobby'
                    && validJoin(get(gatePath(code)).data,getAfter(gatePath(code)).data,request.resource.data.seat))))
          )
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 14
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() >= 1
          && request.resource.data.emoji.size() <= 16
          && request.resource.data.joinedAt is int
          && request.resource.data.joinedAt > 0;
        allow update, delete: if false;
      }

      match /votes/{voteId} {
        // V3 excludes outsiders, but members retain existing vote reads until P3-4.
        allow read: if signedIn() && readableRoomChildren(code);
        allow create: if signedIn()
          && playerExists(code, request.auth.uid)
          && roomIsVoting(code)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.roundIndex == get(roomPath(code)).data.roundIndex
          && voteId == request.auth.uid + '_' + string(request.resource.data.roundIndex)
          && request.resource.data.keys().hasOnly(['uid', 'roundIndex', 'choice', 'guess', 'double', 'at'])
          && request.resource.data.keys().hasAll(['uid', 'roundIndex', 'choice', 'guess', 'double', 'at'])
          && request.resource.data.choice is int
          && request.resource.data.guess is int
          && request.resource.data.choice >= 0 && request.resource.data.choice <= 3
          && request.resource.data.guess >= 0 && request.resource.data.guess <= 3
          && request.resource.data.double is bool
          && request.resource.data.at is int && request.resource.data.at > 0;
        allow update, delete: if false;
      }
    }
  }
}
